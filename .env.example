MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_DATABASE=signal_logger
MYSQL_USER=logger_user
MYSQL_PASSWORD=logger_password
LIVE_TRADING_ENABLED=false
POLL_INTERVAL_SECONDS=2
MAX_SPREAD_CENTS=3.0
PAPER_POSITION_SIZE=1
SLIPPAGE_MODE=realistic        # optimistic | realistic | harsh

# Optional: Kalshi API base URL (defaults to demo environment)
KALSHI_API_BASE=https://demo-api.kalshi.co/trade-api/v2
KALSHI_API_TIMEOUT_SECONDS=8

# Active 15-minute BTC binary logger
KALSHI_BTC_BINARY_SERIES_TICKER=KXBTC
KALSHI_BTC_BINARY_MAX_STRIKE_GAP=1500
KALSHI_BTC_BINARY_MAX_TIME_TO_CLOSE_SECONDS=1200

# Hourly BTC range market observability (set ONE of these to enable)
# KALSHI_BTC_RANGE_EVENT_TICKER=KXBTC-25060313   # specific event
# KALSHI_BTC_RANGE_SERIES_TICKER=KXBTCR          # whole series (recommended)
KALSHI_BTC_RANGE_EVENT_TICKER=
KALSHI_BTC_RANGE_SERIES_TICKER=
RANGE_MARKET_POLL_INTERVAL_SECONDS=30

RESEARCH_API_TOKEN=change_me
RESEARCH_API_MAX_ROWS=200

# ══════════════════════════════════════════════════════════════════════════════
# Momentum LIVE trading (REAL MONEY) — app/momentum_live_trader.py
# ══════════════════════════════════════════════════════════════════════════════
# DEFAULTS ARE NON-LIVE. The live trader stays INERT (no orders) unless ALL of
# the gates below are explicitly set. This is separate from LIVE_TRADING_ENABLED
# (which guards the research logger and must stay false).
#
# Required to arm real orders:
MOMENTUM_LIVE_ENABLED=false
# Must be exactly this token to confirm you understand real money is at stake:
MOMENTUM_LIVE_CONFIRM=
#   set to: I_UNDERSTAND_REAL_MONEY
# Authenticated trading also requires KALSHI_KEY_ID + KALSHI_KEY_FILE (above).

# Kill switch — engage to immediately stop opening new live trades.
MOMENTUM_LIVE_KILL_SWITCH=false
# Optional: if this file exists, the kill switch is also engaged.
MOMENTUM_LIVE_KILL_SWITCH_FILE=

# Bankroll + Kelly sizing (all must be > 0 to arm):
MOMENTUM_LIVE_BANKROLL_DOLLARS=0
MOMENTUM_LIVE_KELLY_FRACTION=0          # e.g. 0.25 = quarter Kelly
MOMENTUM_LIVE_MAX_DOLLARS_PER_TRADE=0
MOMENTUM_LIVE_MAX_CONTRACTS_PER_TRADE=0 # 0 = no explicit contract cap

# Risk gates:
MOMENTUM_LIVE_MAX_ACTIVE_TRADES=1
MOMENTUM_LIVE_MAX_DAILY_LOSS_DOLLARS=0  # 0 disables the daily-loss gate
MOMENTUM_LIVE_MAX_SPREAD=0.04           # dollar fraction (0.04 = 4 cents)
MOMENTUM_LIVE_QUOTE_MAX_AGE_SECONDS=5
MOMENTUM_LIVE_MIN_SHADOW_TRADES=50      # min shadow history before sizing
MOMENTUM_LIVE_PROJECTED_WINDOW=100      # rolling shadow window for Kelly inputs
MOMENTUM_LIVE_ENTRY_PRICE_OFFSET_CENTS=0.01
MOMENTUM_LIVE_RETRY_AFTER_CANCEL_SECONDS=20
MOMENTUM_LIVE_ENTRY_FILL_TIMEOUT_SECONDS=10

# Automatic pause when live actual drifts below shadow projected:
LIVE_PAUSE_MIN_TRADES=25                # do not pause on tiny samples
LIVE_PAUSE_WIN_RATE_GAP_PCT=15          # percentage points
LIVE_PAUSE_EXPECTANCY_GAP_CENTS=0.02    # dollar fraction / contract
LIVE_PAUSE_PROFIT_FACTOR_GAP=0.5

# WebSocket-first clean-data observer.
# Production prediction-market endpoint. Do not use external-api-margin-ws here.
KALSHI_WS_URL=wss://external-api-ws.kalshi.com/trade-api/ws/v2
MOMENTUM_LIVE_USE_WEBSOCKET=false
MOMENTUM_LIVE_WS_RECONNECT_SECONDS=3
MOMENTUM_LIVE_WS_STALE_AFTER_SECONDS=5
MOMENTUM_LIVE_WS_PING_INTERVAL_SECONDS=20
MOMENTUM_LIVE_WS_PING_TIMEOUT_SECONDS=20

# When enabled, the logger feeds shadow/live diagnostics from fresh WebSocket
# order books. Missing/stale WS books skip the tick instead of silently using
# REST/poll quote data.
MOMENTUM_WS_OBSERVER_ENABLED=false
MOMENTUM_WS_OBSERVER_REQUIRE_FRESH_QUOTES=true
MOMENTUM_WS_OBSERVER_BOOT_TIMEOUT_SECONDS=10
