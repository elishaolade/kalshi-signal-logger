MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_DATABASE=signal_logger
MYSQL_USER=logger_user
MYSQL_PASSWORD=logger_password
LIVE_TRADING_ENABLED=false
POLL_INTERVAL_SECONDS=2
MAX_SPREAD_CENTS=3.0
PAPER_POSITION_SIZE=1
SLIPPAGE_MODE=realistic        # optimistic | realistic | harsh

# Optional: Kalshi API base URL (defaults to demo environment)
KALSHI_API_BASE=https://demo-api.kalshi.co/trade-api/v2
KALSHI_API_TIMEOUT_SECONDS=8

# Active 15-minute BTC binary logger
KALSHI_BTC_BINARY_SERIES_TICKER=KXBTC
KALSHI_BTC_BINARY_MAX_STRIKE_GAP=1500
KALSHI_BTC_BINARY_MAX_TIME_TO_CLOSE_SECONDS=1200

# Hourly BTC range market observability (set ONE of these to enable)
# KALSHI_BTC_RANGE_EVENT_TICKER=KXBTC-25060313   # specific event
# KALSHI_BTC_RANGE_SERIES_TICKER=KXBTCR          # whole series (recommended)
KALSHI_BTC_RANGE_EVENT_TICKER=
KALSHI_BTC_RANGE_SERIES_TICKER=
RANGE_MARKET_POLL_INTERVAL_SECONDS=30

RESEARCH_API_TOKEN=change_me
RESEARCH_API_MAX_ROWS=200
